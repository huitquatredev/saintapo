---
const nav = [
  { label: 'Le Domaine', href: '#domaine' },
  { label: 'La Biodynamie ?', href: '#biodynamie' },
  { label: 'Nos Vins', href: '#vins' },
  { label: 'Nous rencontrer', href: '#rencontrer' },
  { label: 'Actualités', href: '#actualites' },
];
---

<header class="site-head" id="site-head">
  <div class="topbar">
    <div class="shell topbar-inner">
      <span>Puyméras — Côtes du Rhône — Vaucluse</span>
      <span><i class="topbar-dot" aria-hidden="true"></i>Biodynamie depuis 1967 · Demeter &amp; Ecocert</span>
    </div>
  </div>

  <div class="navbar">
    <div class="shell navbar-inner">
      <a class="brand" href="/" aria-label="Domaine Saint Apollinaire — accueil">
        <svg class="brand-mark" viewBox="0 0 40 44" fill="none" aria-hidden="true">
          <path d="M20 1.75 37.75 8.2v13.4c0 9.6-7.4 16.7-17.75 20.4C9.65 38.3 2.25 31.2 2.25 21.6V8.2L20 1.75Z" stroke="currentColor" stroke-width="1.15"/>
          <circle cx="20" cy="30.2" r="2.8" stroke="currentColor" stroke-width="1.05"/>
          <path d="M20 24.2v-2M20 36.2v2M14 30.2h-2M28 30.2h2M16.2 26.4l-1.4-1.4M25.2 35.4l-1.4-1.4M23.8 26.4l1.4-1.4M14.8 35.4l1.4-1.4" stroke="currentColor" stroke-width="1.05" stroke-linecap="round"/>
          <path d="M11.5 16.2c2.8-2.4 5.6 2.4 8.5 0s5.7 2.4 8.5 0" stroke="currentColor" stroke-width="1.05" stroke-linecap="round"/>
          <circle cx="13.6" cy="9.4" r="1.25" stroke="currentColor" stroke-width="1"/>
          <circle cx="20" cy="8.4" r="1.25" stroke="currentColor" stroke-width="1"/>
          <circle cx="26.4" cy="9.4" r="1.25" stroke="currentColor" stroke-width="1"/>
        </svg>
        <span class="brand-name">
          <span class="brand-title">Saint Apollinaire</span>
          <span class="brand-sub">Domaine · Puyméras</span>
        </span>
      </a>

      <nav class="main-nav" aria-label="Navigation principale">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <a class="btn nav-cta" href="#contact">
        Contact
        <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M200 56v72a8 8 0 0 1-16 0V81.66L77.66 188a8 8 0 0 1-11.32-11.32L172.69 70.34H120a8 8 0 0 1 0-16h72a8 8 0 0 1 8 8Z"/></svg>
      </a>

      <button class="menu-toggle" type="button" id="menu-toggle" aria-expanded="false" aria-controls="menu-overlay">
        Menu
        <span class="menu-toggle-lines" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu-overlay" id="menu-overlay" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true">
  <div class="menu-top">
    <a class="brand brand--light" href="/" aria-label="Domaine Saint Apollinaire — accueil">
      <svg class="brand-mark" viewBox="0 0 40 44" fill="none" aria-hidden="true">
        <path d="M20 1.75 37.75 8.2v13.4c0 9.6-7.4 16.7-17.75 20.4C9.65 38.3 2.25 31.2 2.25 21.6V8.2L20 1.75Z" stroke="currentColor" stroke-width="1.15"/>
        <circle cx="20" cy="30.2" r="2.8" stroke="currentColor" stroke-width="1.05"/>
        <path d="M20 24.2v-2M20 36.2v2M14 30.2h-2M28 30.2h2" stroke="currentColor" stroke-width="1.05" stroke-linecap="round"/>
        <path d="M11.5 16.2c2.8-2.4 5.6 2.4 8.5 0s5.7 2.4 8.5 0" stroke="currentColor" stroke-width="1.05" stroke-linecap="round"/>
        <circle cx="13.6" cy="9.4" r="1.25" stroke="currentColor" stroke-width="1"/>
        <circle cx="20" cy="8.4" r="1.25" stroke="currentColor" stroke-width="1"/>
        <circle cx="26.4" cy="9.4" r="1.25" stroke="currentColor" stroke-width="1"/>
      </svg>
      <span class="brand-name">
        <span class="brand-title">Saint Apollinaire</span>
        <span class="brand-sub">Domaine · Puyméras</span>
      </span>
    </a>
    <button class="menu-close" type="button" id="menu-close">
      Fermer
      <span aria-hidden="true">×</span>
    </button>
  </div>

  <nav aria-label="Navigation mobile">
    <ul>
      {nav.map((item) => (
        <li><a href={item.href} data-menu-link>{item.label}</a></li>
      ))}
      <li><a href="#contact" data-menu-link>Contact</a></li>
    </ul>
  </nav>

  <div class="menu-contact">
    <a href="tel:+33664290104">06 64 29 01 04</a>
    <a href="mailto:domaine-st-apo@orange.fr">domaine-st-apo@orange.fr</a>
    <span>90 route de Faucon, 84110 Puyméras</span>
  </div>
</div>
